{
  "schema_version": 1,
  "spec": "docs/superpowers/specs/CHANGE-ME.md",
  "model": "opus",
  "fallback_model": "haiku",
  "effort": {
    "plan": "max",
    "implement": "high",
    "review": "max",
    "push": "low"
  },
  "budgets": {
    "plan": 25,
    "implement": 100,
    "review": 40,
    "push": 3
  },
  "max_total_budget_usd": 500,
  "delay_between_phases_seconds": 10,
  "convergence": {
    "max_iterations": 5,
    "min_gaps_for_substantial": 20,
    "persistent_gap_downgrade_after": 3
  },
  "verify_commands": {
    "test": "python -m pytest -q",
    "lint": "python -m ruff check .",
    "format": "python -m ruff format --check ."
  },
  "git_strategy": "main",
  "telemetry": {
    "enabled": true,
    "path": ".claude/telemetry.jsonl"
  },
  "dashboard": {
    "host": "localhost",
    "port": 3000,
    "watch_interval": 2
  },
  "notification_webhook": null,
  "milestones": []
}
